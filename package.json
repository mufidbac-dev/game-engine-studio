{
  "name": "vgc-game-engine-studio",
  "version": "1.0.0",
  "description": "VGC Three.js 3D Game Engine Studio — Modular Editor, Runtime Player & 7 Genre Templates",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ --max-warnings=0",
    "format": "prettier --write src/ tests/ index.html player.html",
    "github:setup": "bash scripts/setup-github.sh"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@tailwindcss/forms": "^0.5.7",
    "@vitest/ui": "^1.4.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.42.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
